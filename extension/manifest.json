{
  "manifest_version": 3,
  "name": "YT Chat — AI Video Assistant",
  "version": "1.0.0",
  "description": "Ask questions about any YouTube video using advanced RAG AI. Side-by-side chat with timestamp citations.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },

  "action": {
    "default_title": "Open YT Chat",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["sidebar/*", "icons/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
